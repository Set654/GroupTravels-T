{
    "python.REPL.enableREPLSmartSend": false,
    "explorer.sortOrder": "foldersFirst",
    "files.exclude": {
        "**/__pycache__": true,
        ".venv": true,
        ".vscode": true,
        "dist": true,
        "**/bin": true,
        "**/obj": true,
        "tickets.json": true
    },
    "python.testing.unittestEnabled": true,
    "python.testing.pytestEnabled": false,
    "python.testing.unittestArgs": [
        "-v",
        "-s",
        "tests",
        "-p",
        "test_*.py"
    ]
}
