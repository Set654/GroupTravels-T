{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Otp": {
    "CodeLifetimeMinutes": 5,
    "MaxAttemptsPerCode": 5,
    "ResendCooldownSeconds": 60,
    "MaxRequestsPerPhonePerHour": 3,
    "MaxRequestsPerPhonePerDay": 10,
    "MaxRequestsPerIpPerHour": 30,
    "MaxRequestsPerIpPerDay": 150,
    "PendingLifetimeSeconds": 120
  },
  "PythonFlightSearch": {
    "BaseUrl": "http://localhost:8000/",
    "TimeoutSeconds": 30
  }
}
