{
  "openapi": "3.1.0",
  "info": {
    "title": "T-Travel internal flight search",
    "description": "SRS 3.5. Cached offers, not confirmed bookings. Internal service only.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/flights/search": {
      "get": {
        "tags": [
          "flights"
        ],
        "summary": "Search Flights",
        "operationId": "searchFlights",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "origin",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16,
              "examples": [
                "MOW"
              ],
              "title": "Origin"
            }
          },
          {
            "name": "destination",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16,
              "examples": [
                "LED"
              ],
              "title": "Destination"
            }
          },
          {
            "name": "departureDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 10,
              "maxLength": 10,
              "examples": [
                "2026-12-15"
              ],
              "title": "Departuredate"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlightSearchResponse"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Gateway Timeout"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse"
      },
      "FlightOffer": {
        "properties": {
          "origin": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "title": "Origin"
          },
          "destination": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "title": "Destination"
          },
          "departureDate": {
            "type": "string",
            "format": "date",
            "title": "Departuredate"
          },
          "departureAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Departureat"
          },
          "airline": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Airline"
          },
          "flightNumber": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Flightnumber"
          },
          "price": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              }
            ],
            "multipleOf": 0.01,
            "maximum": 7.922816251426434e+28,
            "format": "decimal",
            "title": "Price",
            "description": "Positive RUB amount, at most two decimal places; use decimal in C#."
          },
          "currency": {
            "type": "string",
            "const": "RUB",
            "title": "Currency"
          },
          "transfers": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Transfers"
          },
          "durationMinutes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Durationminutes"
          },
          "bookingUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bookingurl"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "origin",
          "destination",
          "departureDate",
          "departureAt",
          "airline",
          "flightNumber",
          "price",
          "currency",
          "transfers",
          "durationMinutes",
          "bookingUrl"
        ],
        "title": "FlightOffer"
      },
      "FlightSearchResponse": {
        "properties": {
          "source": {
            "type": "string",
            "const": "Aviasales",
            "title": "Source",
            "default": "Aviasales"
          },
          "dataType": {
            "type": "string",
            "const": "cached_offers",
            "title": "Datatype",
            "default": "cached_offers"
          },
          "currency": {
            "type": "string",
            "const": "RUB",
            "title": "Currency",
            "default": "RUB"
          },
          "flights": {
            "items": {
              "$ref": "#/components/schemas/FlightOffer"
            },
            "type": "array",
            "title": "Flights"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "flights"
        ],
        "title": "FlightSearchResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Internal-Api-Key"
      }
    }
  }
}
